root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

# Golden files must be byte-exact (hard line breaks may end in two spaces).
[tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false
